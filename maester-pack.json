{
  "$schema": "https://maester.dev/schemas/maester-pack-1.0.json",
  "Id": "maester365.demo",
  "Name": "Maester demo pack",
  "Description": "A pack for trying out Maester Packs: one test for each result, a connector of its own, a Microsoft Graph read and a long-running test with live progress and an embedded report.",
  "Version": "1.0.0",
  "Publisher": "maester365",
  "License": "MIT",
  "RequiresMaester": ">=3.0",
  "Code": "DEMO",
  "Suites": [
    "tests"
  ],
  "Helpers": [
    "helpers"
  ],
  "Connectors": [
    {
      "Service": "DEMO.Sample",
      "DisplayName": "Demo sample service",
      "File": "connector/Connect-DemoSample.ps1",
      "Connect": "Connect-DemoSample",
      "Test": "Test-DemoSample",
      "Disconnect": "Disconnect-DemoSample"
    }
  ],
  "Uses": {
    "Services": [
      "DEMO.Sample",
      "Graph"
    ],
    "GraphScopes": [
      "Organization.Read.All"
    ],
    "Network": [],
    "Modules": []
  }
}
